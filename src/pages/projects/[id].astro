---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (src?: string) => (src && src.startsWith('/') ? `${base}${src}` : src);
const d = project.data;
---
<Base title={d.title} description={d.summary} image={d.image}>
  <article class="container-x max-w-4xl py-16 sm:py-24">
    <a href={`${base}/#work`} class="text-sm text-slate-500 hover:text-accent">← All projects</a>
    {d.category && <p class="eyebrow mt-10">{d.category}</p>}
    <h1 class="font-display mt-3 text-4xl font-extrabold tracking-tight sm:text-6xl">{d.title}</h1>
    <p class="mt-5 text-xl text-slate-600 dark:text-slate-400">{d.summary}</p>
    <div class="mt-6 flex flex-wrap gap-2">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
    <div class="mt-8 flex flex-wrap gap-3">
      {d.liveUrl && <a href={d.liveUrl} target="_blank" rel="noopener" class="btn-primary">Visit live site <Icon name="arrow" class="h-4 w-4" /></a>}
      {d.repoUrl && <a href={d.repoUrl} target="_blank" rel="noopener" class="btn-ghost">View code</a>}
    </div>
    {d.image && <img src={img(d.image)} alt={d.title} class="mt-12 w-full rounded-2xl border border-black/10 dark:border-white/10" />}
    <div class="prose-body mt-12 text-lg"><Content /></div>
  </article>
</Base>
