---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TechIcon from '../components/TechIcon.astro';
import settings from '../data/settings.json';
import skills from '../data/skills.json';
import home from '../data/home.json';

const byOrder = (a: any, b: any) => a.data.order - b.data.order;
const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(byOrder);
const services = (await getCollection('services')).sort(byOrder);
const experience = (await getCollection('experience')).sort(byOrder);
const education = (await getCollection('education')).sort(byOrder);
const certs = (await getCollection('certifications')).sort(byOrder);
const testimonials = (await getCollection('testimonials')).sort(byOrder);
const aboutParas = settings.about.split(/\n\s*\n/).filter(Boolean);
const initials = settings.name.split(' ').map((w) => w[0]).join('').slice(0, 2);
const stickers = projects.filter((p) => p.data.image).slice(0, 3);
const serviceColors = ['var(--sun)', 'var(--pink)', 'var(--mint)', 'var(--sky)', 'var(--lilac)'];
const ring = `${settings.availabilityText} ✦ ${settings.availabilityText} ✦ `;
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="hi">
          <span class="face">{settings.photo ? <img src={settings.photo} alt="" /> : initials}</span>
          Hi, I'm {settings.name.split(' ')[0]}. {settings.role}.
        </p>
        <h1>{settings.headline}</h1>
        <p class="lede">{settings.intro}</p>
        <div class="buttons">
          <a href="#contact" class="btn btn-ink">Start a project <Icon name="arrow" size={18} /></a>
          <a href="#work" class="btn">See my work</a>
        </div>
      </div>
      <div class="stack">
        {stickers.map((p) => (
          <a href={`/projects/${p.id}/`} class="sticker">
            <img src={p.data.image} alt={`Screenshot of ${p.data.title}`} />
            <span>{p.data.title}</span>
          </a>
        ))}
        {settings.available && (
          <div class="badge" role="img" aria-label={settings.availabilityText}>
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <defs><path id="ring" d="M60 60 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0" /></defs>
              <text font-size="11" font-weight="800" fill="#17153b"><textPath href="#ring" textLength="286" lengthAdjust="spacingAndGlyphs">{ring}</textPath></text>
            </svg>
            <b aria-hidden="true">✦</b>
          </div>
        )}
      </div>
    </div>
  </section>

  {services.length > 0 && (
    <section id="services" class="block">
      <div class="wrap">
        <h2 class="title">What I can build for you</h2>
        <p class="lede">From a simple website to a full ERP with a mobile app, I can take your project from idea to launch.</p>
        <div class="services">
          {services.map((s, i) => (
            <article class="chunk service">
              <div class="ico" style={`background:${serviceColors[i % serviceColors.length]}`}><Icon name={s.data.icon} size={28} /></div>
              <h3>{s.data.title}</h3>
              <p>{s.data.summary}</p>
              {s.data.includes.length > 0 && <ul class="includes">{s.data.includes.map((x) => <li>{x}</li>)}</ul>}
              {s.data.price && <span class="price">{s.data.price}</span>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section id="work" class="block work">
      <div class="wrap">
        <h2 class="title">Things I've built</h2>
        <p class="lede">Client work, personal builds and concepts across websites, web apps, mobile apps and ERP. Open any project to read how it was made.</p>
        <div class="projects">
          {projects.map((p) => (
            <a href={`/projects/${p.id}/`} class="chunk project">
              <div class="shot">{p.data.image && <img src={p.data.image} alt={`Screenshot of ${p.data.title}`} loading="lazy" />}</div>
              <div class="info">
                {p.data.kind && <span class="pill kindtag">{p.data.kind}</span>}
                <h3>{p.data.title}</h3>
                <p>{p.data.summary}</p>
                <div class="pills">{p.data.tags.slice(0, 4).map((t) => <span class="pill">{t}</span>)}</div>
                <span class="more">Read the case study</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {home.process.length > 0 && (
    <section id="process" class="block process">
      <div class="wrap">
        <h2 class="title">How we'll work together</h2>
        <p class="lede">A clear process, so you always know what's happening and what comes next.</p>
        <ol class="steps" style={`--n:${home.process.length}`}>
          {home.process.map((s) => (
            <li class="chunk step"><h3>{s.title}</h3><p>{s.text}</p></li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section id="about" class="block about">
    <div class="wrap about-grid">
      <div class="portrait">{settings.photo ? <img src={settings.photo} alt={settings.name} /> : <span class="ini">{initials}</span>}</div>
      <div>
        <h2 class="title">About me</h2>
        <div class="about-text">{aboutParas.map((p) => <p>{p}</p>)}</div>
      </div>
    </div>
  </section>

  <section id="stack" class="block stack-block">
    <div class="wrap">
      <h2 class="title">Tech I work with</h2>
      <p class="lede">I pick the right tools for each project, not the same ones every time.</p>
      <div class="tech-groups">
        {skills.groups.map((g) => (
          <div class="chunk tech-group">
            <h3>{g.title}</h3>
            <ul class="tech-list">
              {g.items.map((t: any) => {
                const item = typeof t === 'string' ? { name: t, icon: '' } : t;
                return <li><span class="tech-logo"><TechIcon slug={item.icon} size={22} /></span>{item.name}</li>;
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {(experience.length > 0 || education.length > 0) && (
    <section id="experience" class="block">
      <div class="wrap">
        <h2 class="title">Experience</h2>
        <div class="exp-grid">
          {experience.length > 0 && (
            <ol class="chunk timeline">
              {experience.map((e) => (
                <li>
                  <time>{e.data.start} to {e.data.current ? <span class="pill now">Now</span> : e.data.end}</time>
                  <div>
                    <h3>{e.data.role}</h3>
                    <p class="meta">{e.data.companyUrl ? <a href={e.data.companyUrl} target="_blank" rel="noopener">{e.data.company}</a> : e.data.company}{e.data.location && `, ${e.data.location}`}</p>
                    {e.rendered?.html && <div class="body" set:html={e.rendered.html} />}
                  </div>
                </li>
              ))}
            </ol>
          )}
          <div>
            {education.length > 0 && (
              <div class="chunk side-card" style="background:var(--sun)">
                <h3 class="h">Education</h3>
                {education.map((e) => (
                  <div class="row"><strong>{e.data.degree}</strong><br />{e.data.institute}, {e.data.start}{e.data.end && `–${e.data.end}`}{e.data.grade && `, ${e.data.grade}`}</div>
                ))}
              </div>
            )}
            {certs.length > 0 && (
              <div class="chunk side-card">
                <h3 class="h">Certifications</h3>
                {certs.map((c) => (
                  <div class="row">{c.data.url ? <a href={c.data.url} target="_blank" rel="noopener"><strong>{c.data.title}</strong></a> : <strong>{c.data.title}</strong>}<br />{c.data.issuer}{c.data.date && `, ${c.data.date}`}</div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="block" style="background:var(--sun)">
      <div class="wrap">
        <h2 class="title">What clients say</h2>
        <div class="projects">
          {testimonials.map((t) => (
            <figure class="chunk" style="padding:28px">
              <blockquote style="font-size:20px;font-weight:500">“{t.data.quote}”</blockquote>
              <figcaption style="margin-top:16px;font-weight:800">{t.data.name}{t.data.role && <span style="font-weight:500">, {t.data.role}</span>}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {home.faq.length > 0 && (
    <section id="faq" class="block faq">
      <div class="wrap">
        <h2 class="title">Questions clients ask</h2>
        <div class="faq-list">
          {home.faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}<span class="x"><Icon name="plus" size={18} /></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="contact" class="block contact">
    <div class="wrap contact-grid">
      <div>
        <h2 class="title">Got a project? Let's talk.</h2>
        <p class="lede">Tell me what you need and I'll reply with ideas, a rough timeline and a price. {settings.responseTime}.</p>
        <a href={`mailto:${settings.email}`} class="mail">{settings.email}</a>
        <div class="socials">{settings.socials.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}</div>
      </div>
      {settings.contactFormKey ? (
        <form id="contact-form" class="form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value={settings.contactFormKey} />
          <input type="hidden" name="subject" value="New project enquiry from your portfolio" />
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
          <div class="row"><label for="f-name">Your name</label><input id="f-name" name="name" required autocomplete="name" /></div>
          <div class="row"><label for="f-email">Email</label><input id="f-email" name="email" type="email" required autocomplete="email" /></div>
          <div class="row"><label for="f-msg">What do you need?</label><textarea id="f-msg" name="message" rows="5" required></textarea></div>
          <button type="submit" class="btn">Send message</button>
          <p id="form-status" class="status" role="status"></p>
        </form>
      ) : (
        <div class="form">
          <p style="font-family:var(--font-display);font-weight:800;font-size:24px;line-height:1.2">The fastest way to reach me is email.</p>
          <p style="margin-top:10px">Share a few lines about your business and what you want the website to do.</p>
          <a href={`mailto:${settings.email}?subject=New%20project%20enquiry`} class="btn">Write an email</a>
        </div>
      )}
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    form?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (status) status.textContent = 'Sending your message…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const json = await res.json();
        if (json.success) { form.reset(); if (status) status.textContent = 'Message sent. I will reply soon.'; }
        else if (status) status.textContent = 'The message could not be sent. Please email me instead.';
      } catch { if (status) status.textContent = 'The message could not be sent. Please email me instead.'; }
    });
  </script>
</Base>
